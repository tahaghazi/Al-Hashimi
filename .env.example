# Copy to .env and fill in real values. .env is gitignored.

# Generate a fresh key for any real deployment, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Turn OFF in production.
DJANGO_DEBUG=true

# Comma-separated hostnames the app may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF. In production set CORS_ALLOW_ALL_ORIGINS=false and list origins.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
